<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Nandini Reddy — Resume</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
  :root {
    --cream: #faf6f0;
    --warm-bg: #f5ede0;
    --sidebar-bg: #2b2118;
    --accent: #c9623f;
    --accent2: #e8a87c;
    --text-dark: #1e1510;
    --text-mid: #4a3728;
    --text-light: #7a6355;
    --sidebar-text: #f0e8dd;
    --sidebar-muted: #b8a090;
    --tag-bg: #ede3d8;
    --tag-border: #d4bfa8;
    --rule: #ddd0c0;
    --photo-border: #c9623f;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: #e8ddd0;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-height: 100vh;
    padding: 20px;
  }

  .page {
    width: 210mm;
    min-height: 297mm;
    background: var(--cream);
    display: grid;
    grid-template-columns: 68mm 1fr;
    position: relative;
    box-shadow: 0 8px 40px rgba(0,0,0,0.18);
    overflow: hidden;
  }

  /* ── SIDEBAR ── */
  .sidebar {
    background: var(--sidebar-bg);
    color: var(--sidebar-text);
    padding: 28px 18px 28px 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
    justify-content: flex-start;
    min-height: 297mm;
  }

  .sidebar::after {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(to bottom, var(--accent), transparent 60%);
  }

  /* Photo slot */
  .photo-slot {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    border: 3px solid var(--accent);
    background: #3d2c1e;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 4px;
    overflow: hidden;
    position: relative;
  }
  .photo-slot .photo-label {
    font-size: 9px;
    color: var(--sidebar-muted);
    text-align: center;
    line-height: 1.4;
    font-style: italic;
    padding: 6px;
  }

  .name-block {
    text-align: center;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .name-block h1 {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.3px;
    line-height: 1.2;
  }
  .name-block .tagline {
    font-size: 9.5px;
    color: var(--accent2);
    letter-spacing: 1.8px;
    text-transform: uppercase;
    margin-top: 5px;
    font-weight: 500;
  }

  .s-section { display: flex; flex-direction: column; gap: 7px; }
  .s-label {
    font-size: 8.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent2);
    font-weight: 600;
    border-bottom: 1px solid rgba(201,98,63,0.35);
    padding-bottom: 4px;
    margin-bottom: 2px;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    font-size: 10px;
    color: var(--sidebar-text);
    line-height: 1.4;
  }
  .contact-item .icon {
    color: var(--accent);
    font-size: 10px;
    min-width: 12px;
    margin-top: 1px;
  }

  .lang-pills {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .lang-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    color: var(--sidebar-text);
    font-weight: 400;
  }
  .lang-pill::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .skill-group { margin-bottom: 5px; }
  .skill-group-label {
    font-size: 9px;
    color: var(--sidebar-muted);
    font-weight: 500;
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }
  .chip {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    color: var(--sidebar-text);
    font-size: 9px;
    padding: 2px 7px;
    border-radius: 3px;
    font-weight: 400;
    line-height: 1.5;
  }
  .chip.learn {
    border-color: rgba(201,98,63,0.4);
    color: var(--accent2);
    font-style: italic;
  }

  .soft-list { list-style: none; }
  .soft-list li {
    font-size: 9.5px;
    color: var(--sidebar-text);
    padding: 2px 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .soft-list li::before {
    content: '◈';
    color: var(--accent);
    font-size: 7px;
  }

  .interest-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .interest-list li {
    font-size: 10px;
    color: var(--sidebar-muted);
    display: flex;
    align-items: center;
    gap: 8px;
    line-height: 1.4;
  }
  .interest-list li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(201,98,63,0.5);
    flex-shrink: 0;
  }

  /* ── MAIN ── */
  .main {
    padding: 26px 22px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: var(--cream);
  }

  .summary-block {
    border-left: 3px solid var(--accent);
    padding-left: 12px;
    background: linear-gradient(to right, rgba(201,98,63,0.06), transparent);
    padding-top: 6px;
    padding-bottom: 6px;
    border-radius: 0 4px 4px 0;
  }
  .summary-block p {
    font-size: 10.5px;
    color: var(--text-mid);
    line-height: 1.65;
    font-weight: 400;
  }
  .summary-block p strong {
    color: var(--accent);
    font-weight: 600;
  }

  .section { display: flex; flex-direction: column; gap: 8px; }
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-dark);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  /* Education */
  .edu-block {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .edu-left h3 {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-dark);
  }
  .edu-left .edu-inst {
    font-size: 10px;
    color: var(--text-mid);
    margin-top: 1px;
  }
  .edu-left .edu-sub {
    font-size: 9.5px;
    color: var(--text-light);
    margin-top: 2px;
    line-height: 1.5;
  }
  .edu-right {
    text-align: right;
    flex-shrink: 0;
    margin-left: 10px;
  }
  .edu-right .year {
    font-size: 9.5px;
    color: var(--accent);
    font-weight: 600;
  }
  .cgpa-badge {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 3px;
    margin-top: 4px;
  }

  /* Projects */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px;
  }
  .project-card {
    background: var(--warm-bg);
    border-radius: 6px;
    padding: 9px 10px;
    border: 1px solid var(--rule);
    position: relative;
    overflow: hidden;
  }
  .project-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 3px;
    height: 100%;
    background: var(--accent);
  }
  .project-card.ml::before { background: #9b59b6; }
  .project-card.ux::before { background: #27ae60; }
  .project-card.hack::before { background: #e67e22; }

  .project-name {
    font-size: 10.5px;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 3px;
    padding-left: 4px;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    margin-bottom: 5px;
    padding-left: 4px;
  }
  .ptag {
    font-size: 8px;
    background: #fff;
    border: 1px solid var(--tag-border);
    color: var(--text-light);
    padding: 1px 5px;
    border-radius: 2px;
    font-weight: 500;
  }
  .project-desc {
    font-size: 9.5px;
    color: var(--text-mid);
    line-height: 1.55;
    padding-left: 4px;
  }
  .project-award {
    display: inline-block;
    background: rgba(201,98,63,0.12);
    color: var(--accent);
    font-size: 8.5px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 3px;
    margin-top: 4px;
    margin-left: 4px;
  }

  /* Hackathons */
  .hack-list { list-style: none; display: flex; flex-direction: column; gap: 5px; }
  .hack-list li {
    font-size: 9.5px;
    color: var(--text-mid);
    display: grid;
    grid-template-columns: 6px 1fr;
    gap: 8px;
    align-items: flex-start;
    line-height: 1.55;
  }
  .hack-list li .dot {
    color: var(--accent);
    font-size: 16px;
    line-height: 1.1;
    flex-shrink: 0;
  }

  /* Learning */
  .learning-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 6px;
  }
  .learn-card {
    background: var(--warm-bg);
    border: 1px solid var(--rule);
    border-radius: 5px;
    padding: 8px 9px;
    border-top: 2px solid var(--accent2);
  }
  .learn-card h4 {
    font-size: 9.5px;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 3px;
  }
  .learn-card p {
    font-size: 9px;
    color: var(--text-light);
    line-height: 1.5;
  }

  /* Courses row */
  .courses-row {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 2px;
  }
  .course-chip {
    background: #fff;
    border: 1px solid var(--rule);
    font-size: 9px;
    color: var(--text-mid);
    padding: 2px 8px;
    border-radius: 20px;
  }

  @media print {
    body { background: white; padding: 0; }
    .page { box-shadow: none; width: 100%; }
  }
</style>
</head>
